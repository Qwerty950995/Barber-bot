import logging
import os
from aiogram import Bot, Dispatcher, types
from aiogram.types import ReplyKeyboardMarkup, KeyboardButton
from aiogram.utils import executor

# Получаем токен и ID админа из переменных окружения
API_TOKEN = os.getenv("API_TOKEN")
ADMIN_ID = int(os.getenv("ADMIN_ID", 0))

# Настройка логов
logging.basicConfig(level=logging.INFO)

# Создание бота и диспетчера
bot = Bot(token=API_TOKEN)
dp = Dispatcher(bot)

# Клавиатура
main_kb = ReplyKeyboardMarkup(resize_keyboard=True)
main_kb.add(KeyboardButton("Записаться"), KeyboardButton("Мои записи"))

# Хранилище записей (в памяти)
appointments = {}

@dp.message_handler(commands=['start'])
async def start_cmd(message: types.Message):
    await message.answer("Привет! Я бот барбершопа. Чем могу помочь?", reply_markup=main_kb)

@dp.message_handler(lambda message: message.text == "Записаться")
async def handle_booking(message: types.Message):
    await message.answer("Напиши дату и время (например: 20 апреля, 14:00)")

@dp.message_handler(lambda message: ',' in message.text)
async def save_appointment(message: types.Message):
    user_id = message.from_user.id
    appointments.setdefault(user_id, []).append(message.text)
    await message.answer("Ты успешно записан!")

@dp.message_handler(lambda message: message.text == "Мои записи")
async def show_my_appointments(message: types.Message):
    user_id = message.from_user.id
    user_appointments = appointments.get(user_id, [])
    if user_appointments:
        await message.answer("Твои записи:\n" + "\n".join(user_appointments))
    else:
        await message.answer("У тебя пока нет записей.")

@dp.message_handler(commands=['admin'])
async def admin_view(message: types.Message):
    if message.from_user.id == ADMIN_ID:
        text = "Список всех записей:\n"
        for user, appts in appointments.items():
            text += f"{user}:\n" + "\n".join(appts) + "\n\n"
        await message.answer(text)
    else:
        await message.answer("У тебя нет доступа.")

if __name__ == '__main__':
    executor.start_polling(dp, skip_updates=True)
